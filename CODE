// GLOBAL CONSTANTS
const int MAX_WORDS = 466551;

const string LINEAR_SEARCH_UNSORTED = "LINEAR_UNSORTED";
const string LINEAR_SEARCH_SORTED = "LINEAR_SORTED";
const string BINARY_SEARCH = "BINARY";

// DEBUG FLAG
const bool DEBUG = true;

// FUNCTION PROTOTYPES
void initializeArray(string dictArray[], int size);

bool populateArray(string dictArray[], int size, string filename);

int countNonEmptyWords(const string dictArray[], int size);
//down here is for lab 7
bool linearSearchUnsorted(const string dictArray[],string word, int size);

bool linearSearchSorted(const string dictArray[],string word, int size);

bool binarySearch(const string dictArray[],string word, int size);

bool spellCheck(const string dictArray[], string word, string searchType, int size);


int main()
{
    // CREATE DICTIONARY ARRAY//given in lab 7 
    string* dictionary = new string[MAX_WORDS];//string* use is dynamic

    // SETTINGS VARIABLES
    int maxMistakes = 3;
    string searchType = LINEAR_SEARCH_UNSORTED;

    string filename = "dictionary.txt";

    // LOAD SETTINGS FILE
    ifstream settingsFile("settings.txt");

    if (settingsFile.is_open())
