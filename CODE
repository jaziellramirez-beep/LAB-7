    }

    // WELCOME MESSAGE
    cout << "*****************************" << endl;
    cout << "Welcome to the spell checker!" << endl;
    cout << "*****************************" << endl;

    // 1. INITIALIZE ARRAY
    initializeArray(dictionary, MAX_WORDS);

    // 2. POPULATE ARRAY
    bool success = populateArray(dictionary, MAX_WORDS, filename);

    if (!success)
    {
        cout << "Error: Could not load dictionary file!" << endl;

        delete[] dictionary;
        return 1;
    }

    // 3. COUNT WORDS
    int activeWords = countNonEmptyWords(dictionary, MAX_WORDS);

    cout << "Loaded " << activeWords<< " words from dictionary." << endl;

    // 4. SORT ARRAY IF NEEDED
    if (searchType == LINEAR_SEARCH_SORTED ||searchType == BINARY_SEARCH){
        sort(dictionary, dictionary + activeWords);
    }

    // PROGRAM VARIABLES
    string word;
    char answer = 'Y';
    int mistakes = 0;

    // 5. MAIN LOOP
    while (answer == 'Y' || answer == 'y')
    {
        cout << "Please enter a word: ";
        cin >> word;

        // START TIMER
        auto start = high_resolution_clock::now();

        // SEARCH FOR WORD
        bool found = spellCheck(dictionary, word,searchType, activeWords);

        // END TIMER
        auto end = high_resolution_clock::now();

        auto elapsed = duration_cast<microseconds>(end - start).count();

        // CHECK IF WORD WAS FOUND
        if (found == true){
            cout << "The word " << word<< " is spelled correctly!" << endl;

            // RESET MISTAKES
            mistakes = 0;
        }
        else
        {
            cout << "uh-oh It looks like '" << word<< "'wasn't spelt right"<< endl;
            cout <<"Let's try spelling it again."<< endl;

            mistakes++;
        }

        // DISPLAY SEARCH TIME
        if (DEBUG == true)
        {
            if (searchType == BINARY_SEARCH){
                cout << "Binary search took " << elapsed<< " microseconds." << endl;
            }
            else{ 
                cout << "Linear search took " << elapsed<< " microseconds." << endl;
            }
        }

        // CHECK MAXIMUM MISTAKES
        if (mistakes >= maxMistakes)
        {
            cout << "You have reached the maximum number ("<< maxMistakes<< ") of misspelled words allowed." << endl;
            cout << "Thank you for using the spell checker!"<< endl;

            break;
        }

        // ASK IF STUDENT WANTS TO CONTINUE
        cout << "Do you want to continue (Y/N): ";
        cin >> answer;
    }

    // GOODBYE MESSAGE
    if (answer == 'N' || answer == 'n')
    {
        cout << "Thank you for using the spell checker!" << endl;
    }

    // DELETE ARRAY
    delete[] dictionary;

    return 0;
}







// FUNCTIONS


// FUNCTION 1: INITIALIZE ARRAY
void initializeArray(string dictArray[], int size)
{
    for (int i = 0; i < size; i++)
    {
        dictArray[i] = "";
    }
}


// FUNCTION 2: POPULATE ARRAY
bool populateArray(string dictArray[], int size, string filename)
{
    ifstream inputFile(filename);

    // CHECK IF FILE EXISTS
    if (!inputFile.is_open())//remember if ! it is false, so this mean is file not open!!!
    {
        return false;
    }

    string word;
    int count = 0;

    // READ WORDS FROM FILE
    while (count < size && inputFile >> word)
    {
        dictArray[count] = word;
        count++;
    }

    inputFile.close();

    return true;
}


// FUNCTION 3: COUNT NONEMPTY WORDS
int countNonEmptyWords(const string dictArray[], int size)
{
    int count = 0;

    for (int i = 0; i < size; i++)
    {
        if (dictArray[i] != "")
        {
            count++;
        }
    }

    return count;
}

//NEW ONE FOR LAB 7 (also check array 3 slides for inspiration)
// FUNCTION 4: LINEAR SEARCH UNSORTED
bool linearSearchUnsorted(const string dictArray[],string word, int size)
{
    for (int i = 0; i < size; i++)
    {
        if (dictArray[i] == word)
        {
            return true;
        }
    }

    return false;
}


// FUNCTION 5: LINEAR SEARCH SORTED
bool linearSearchSorted(const string dictArray[],string word, int size)
{
    for (int i = 0; i < size; i++)
    {
        if (dictArray[i] == word)
        {
            return true;
        }

        if (dictArray[i] > word)
        {
            return false;
        }
    }

    return false;
}


// FUNCTION 6: BINARY SEARCH//array 3
bool binarySearch(const string dictArray[],string word, int size)
{
    int first = 0;
    int last = size - 1;

    while (first <= last)
    {
        int middle = (first + last) / 2;

        if (dictArray[middle] == word)
        {
            return true;
        }
        if (dictArray[middle] < word)
        {
            first = middle + 1;
        }
        else
        {
            last = middle - 1;
        }
    }

    return false;
}


// FUNCTION 7: SPELL CHECK
bool spellCheck(const string dictArray[],string word, string searchType, int size)
{
    if (searchType == LINEAR_SEARCH_UNSORTED)
    {
        return linearSearchUnsorted(dictArray, word, size);
    }
    if (searchType == LINEAR_SEARCH_SORTED)
    {
        return linearSearchSorted(dictArray, word, size);
    }
    if (searchType == BINARY_SEARCH)
    {
        return binarySearch(dictArray, word, size);
    }

    return false;
}
